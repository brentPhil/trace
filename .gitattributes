# Normalise line endings on the way in, so a Windows checkout cannot commit
# CRLF and a Unix checkout cannot see a diff for it.
* text=auto eol=lf

# Binary, so git never tries to convert them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated — collapse in review, but still diffable on request.
convex/_generated/** linguist-generated=true
src/routeTree.gen.ts linguist-generated=true
