# Copy to .env.local. The first two are written for you by `npx convex dev`.

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:adjective-animal-123

VITE_CONVEX_URL=https://adjective-animal-123.convex.cloud

# Same host as VITE_CONVEX_URL but ending in .site
VITE_CONVEX_SITE_URL=https://adjective-animal-123.convex.site

# This app's own URL in development
VITE_SITE_URL=http://localhost:3000

# NOTE: the variables below do NOT belong here. Convex functions cannot read
# this file, so they are set on the deployment instead.
#
# Required:
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#   npx convex env set SITE_URL http://localhost:3000
#
# Email (password reset). Without RESEND_API_KEY the reset link is written to
# the Convex logs instead of being sent, so the flow stays testable locally:
#   npx convex env set RESEND_API_KEY re_...
#
# Optional email settings:
#   EMAIL_FROM        defaults to "Trace <onboarding@resend.dev>", which only
#                     delivers to your own Resend account address. A verified
#                     domain is required to send anywhere else.
#   RESEND_TEST_MODE  defaults to true, which silently restricts delivery to
#                     Resend's test addresses. Set to "false" for real sending:
#                       npx convex env set RESEND_TEST_MODE false
